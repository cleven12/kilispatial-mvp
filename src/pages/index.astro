---
import Layout from '../layouts/Layout.astro';
import KiliShowcase from '../components/KiliShowcase.svelte';
---

<Layout title="KiliSpatial™ 3D — Geospatial Expedition Viewport for Tour Operators">
  <!-- Sticky Obsidian Header -->
  <header class="sticky top-0 z-40 border-b border-zinc-800 bg-zinc-950/80 backdrop-blur-xl">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-lg bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center font-mono font-bold text-xs text-emerald-400">
          3D
        </div>
        <div class="flex items-baseline gap-2">
          <span class="font-bold text-white tracking-tight text-base">KiliSpatial<span class="text-emerald-400">.</span></span>
          <span class="text-[11px] font-mono text-zinc-400 hidden sm:inline-block">
            by Xenohuru
          </span>
        </div>
      </div>

      <nav class="hidden md:flex items-center gap-6 text-xs font-medium text-zinc-400">
        <a href="#showcase" class="hover:text-zinc-100 transition">Interactive Viewport</a>
        <a href="#integration" class="hover:text-zinc-100 transition">postMessage SDK</a>
        <a href="#features" class="hover:text-zinc-100 transition">Enterprise Specs</a>
        <a
          href="https://kili.xenohuru.com"
          target="_blank"
          rel="noopener"
          class="hover:text-emerald-400 transition inline-flex items-center gap-1"
        >
          <span>Standalone Engine</span>
          <span class="text-[10px]">↗</span>
        </a>
      </nav>

      <div class="flex items-center gap-3">
        <a
          href="#showcase"
          class="px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-emerald-500 hover:bg-emerald-400 text-zinc-950 shadow-sm shadow-emerald-500/20 transition"
        >
          Explore MVP
        </a>
      </div>
    </div>
  </header>

  <!-- Main Content Container -->
  <main id="showcase" class="max-w-7xl mx-auto px-4 sm:px-6 py-12">
    <!-- Hero Intro Section -->
    <div class="max-w-3xl mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-zinc-900 border border-zinc-800 text-zinc-300 text-xs font-mono mb-4">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>Geospatial 3D Engine · B2B Tour Operator SDK</span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white leading-tight">
        Turn static Kilimanjaro itineraries into <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-teal-300">interactive 3D expeditions.</span>
      </h1>

      <p class="mt-4 text-sm sm:text-base text-zinc-400 leading-relaxed max-w-2xl">
        Embed real-time 3D terrain flythroughs, camp altitudes, and elevation profiles directly into your safari website. Synchronize click-to-fly camera movements via browser-native postMessage.
      </p>

      <div class="mt-4 flex flex-wrap items-center gap-4 text-xs font-mono text-zinc-400">
        <span class="flex items-center gap-1.5 text-zinc-300">
          <span class="text-emerald-400">✓</span> Zero-Dependency Iframe
        </span>
        <span class="flex items-center gap-1.5 text-zinc-300">
          <span class="text-emerald-400">✓</span> Two-Way postMessage API
        </span>
        <span class="flex items-center gap-1.5 text-zinc-300">
          <span class="text-emerald-400">✓</span> Real-Time Elevation HUD
        </span>
      </div>
    </div>

    <!-- Hydrated Svelte 5 Island -->
    <KiliShowcase client:load />

    <!-- B2B Architecture & How-It-Works Section -->
    <section id="integration" class="mt-24 pt-12 border-t border-zinc-800">
      <div class="max-w-2xl mb-10">
        <span class="text-xs font-mono uppercase tracking-wider text-emerald-400">Enterprise Integration</span>
        <h2 class="text-2xl font-bold text-white mt-1.5 tracking-tight">Built for Any Tour Operator Stack</h2>
        <p class="text-sm text-zinc-400 mt-1.5 leading-relaxed">
          Whether your agency runs on Astro, WordPress, Django, Next.js, or Webflow, KiliSpatial integrates with a single responsive iframe and synchronizes state seamlessly.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-6 rounded-2xl bg-zinc-900/40 border border-zinc-800 hover:border-zinc-700 transition">
          <div class="text-xs font-mono text-emerald-400 mb-2">01 / RESPONSIVE VIEWPORT</div>
          <h3 class="text-base font-bold text-white mb-2">Zero-Dependency Embed</h3>
          <p class="text-xs text-zinc-400 leading-relaxed">
            Configure initial route, starting day, auto drone camera orbit, and elevation chart visibility purely through query parameters without loading heavy WebGL libraries into your host bundle.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-zinc-900/40 border border-zinc-800 hover:border-zinc-700 transition">
          <div class="text-xs font-mono text-emerald-400 mb-2">02 / BIDIRECTIONAL SYNC</div>
          <h3 class="text-base font-bold text-white mb-2">Two-Way postMessage API</h3>
          <p class="text-xs text-zinc-400 leading-relaxed">
            Clicking a day in your page’s itinerary flies the 3D camera to that camp. Clicking a camp waypoint inside the 3D mountain highlights the matching day on your booking page.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-zinc-900/40 border border-zinc-800 hover:border-zinc-700 transition">
          <div class="text-xs font-mono text-emerald-400 mb-2">03 / ORIGIN LOCKED</div>
          <h3 class="text-base font-bold text-white mb-2">Strict Domain Security</h3>
          <p class="text-xs text-zinc-400 leading-relaxed">
            Protected via <code class="font-mono text-xs text-emerald-400">frame-ancestors</code> Content-Security-Policy and <code class="font-mono text-xs text-emerald-400">VITE_EMBED_ORIGINS</code> so only authorized partner domains can frame the engine.
          </p>
        </div>
      </div>
    </section>
  </main>

  <footer class="mt-24 border-t border-zinc-800 py-8 bg-zinc-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-mono text-zinc-400">
      <div>
        KiliSpatial™ 3D Engine · Powered by Xenohuru · Kilimanjaro Region, Tanzania
      </div>
      <div class="flex items-center gap-4 text-zinc-400">
        <span>WebGL 2.0</span>
        <span>MapLibre 3D</span>
        <span>Svelte 5 Runes</span>
      </div>
    </div>
  </footer>
</Layout>
